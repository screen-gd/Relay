# The website derives the matching .convex.site URL from this value.
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
NEXT_PUBLIC_MARKETING_SITE_URL=https://web.relay-app.cc.cd

# Required for the roadmap: GitHub's GraphQL API needs a token. A fine-grained
# token with read-only Issues access to screen-gd/Relay works. Set it in
# production with `wrangler secret put GITHUB_TOKEN`. Without it the roadmap
# shows its error state.
# GITHUB_TOKEN=
