{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "relay",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "workers_dev": true,
  "vars": {
    "VITE_CLERK_PUBLISHABLE_KEY": "pk_live_Y2xlcmsucmVsYXktYXBwLmNjLmNkJA",
    "VITE_BILLING_PURCHASES_ENABLED": "false",
    "VITE_CONVEX_URL": "https://spotted-pheasant-146.convex.cloud",
    "VITE_FILE_STORAGE_PROVIDER": "convex",
    "VITE_SITE_URL": "https://relay-app.cc.cd",
  },
  "assets": {
    "directory": ".output/public",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
}
