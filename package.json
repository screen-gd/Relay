{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "convex dev --start \"pnpm dev:next\"",
    "dev:next": "next dev",
    "convex:dev": "convex dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "check": "pnpm check:mui-allowlist && pnpm lint && pnpm --dir website lint && pnpm build && pnpm audit --prod",
    "check:full": "pnpm check && pnpm test:unit && pnpm test:convex && pnpm test:stripe-csp && pnpm verify:browser && pnpm verify:prod",
    "start": "next start",
    "lint": "tsc --noEmit",
    "test:unit": "vitest run --config vitest.unit.config.mts",
    "test:convex": "vitest run --config vitest.config.mts",
    "test:stripe-csp": "node --test scripts/check-stripe-csp.test.mjs",
    "check:workspace-layout": "node scripts/check-workspace-layout.mjs",
    "check:mui-allowlist": "node scripts/check-mui-allowlist.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:relay": "node scripts/verify-relay-rebuild.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "verify:team:live": "node scripts/verify-team-live.mjs",
    "verify:browser": "node scripts/verify-browser-smoke.mjs",
    "verify:cloudflare-auth": "node scripts/verify-cloudflare-auth.mjs",
    "verify:light-highlights": "node scripts/verify-light-highlights.mjs",
    "verify:light-logo": "node scripts/verify-light-logo.mjs",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "verify:brand-assets": "node scripts/verify-brand-assets.mjs",
    "verify:ui": "node scripts/verify-ui-interactions.mjs",
    "verify:prod": "node scripts/verify-production.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1093.0",
    "@aws-sdk/s3-request-presigner": "^3.1093.0",
    "@clerk/backend": "^3.16.12",
    "@clerk/nextjs": "^7.8.1",
    "@convex-dev/migrations": "0.3.6",
    "@dnd-kit/core": "^6.3.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "geist": "^1.7.2",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "next": "^16.3.3",
    "radix-ui": "^1.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-is": "^19.2.8",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.1.1",
    "@edge-runtime/vm": "^5.0.0",
    "@next/env": "^16.3.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "convex-test": "^0.0.53",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.8",
    "wrangler": "^4.120.0"
  }
}
