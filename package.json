{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @relay/web dev",
    "dev:web": "pnpm --filter @relay/web dev:web",
    "dev:website": "pnpm --filter @relay/website dev",
    "build": "pnpm --filter @relay/web build",
    "build:website": "pnpm --filter @relay/website build",
    "lint": "pnpm --filter @relay/web lint && pnpm --filter @relay/website lint",
    "test:unit": "pnpm --filter @relay/web test:unit",
    "test:convex": "pnpm --filter @relay/web test:convex",
    "test:e2e": "pnpm --filter @relay/web test:e2e",
    "test:e2e:headed": "pnpm --filter @relay/web test:e2e:headed",
    "check": "pnpm --filter @relay/web check && pnpm --filter @relay/website lint && pnpm audit --prod",
    "check:full": "pnpm --filter @relay/web check:full && pnpm --filter @relay/website lint && pnpm audit --prod",
    "brand:build": "node scripts/build-brand-assets.mjs",
    "verify:brand-assets": "node scripts/verify-brand-assets.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6"
  }
}
